{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dereth",
  "mainBinaryName": "dereth",
  "identifier": "network.dereth.dereth",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dereth",
        "width": 1100,
        "height": 700,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1RUYyQTQ3MkQxN0ZDRjMKUldUei9CY3RSeXJ2TlgxaGZXd2diU2ZxR1JSNEs2RE9TbmtrL1dTMCs0VUtTaWtEMDIwcElKQmgK",
      "endpoints": [
        "https://github.com/dereth-network/dereth/releases/latest/download/latest.json"
      ]
    }
  }
}
