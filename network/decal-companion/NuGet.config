<?xml version="1.0" encoding="utf-8"?>
<!-- The companion builds against the .NET Framework's reference assemblies and tests with MSTest,
     both from nuget.org; Decal's own assemblies come from the player's Decal folder. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
