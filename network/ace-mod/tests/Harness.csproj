<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles only the mod's ACE-free sources, so it runs without an ACE server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Dereth.Network.Harness</AssemblyName>
    <RootNamespace>Dereth.Network.Harness</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="PatchApply/**" />
    <Compile Include="../Dereth.Network/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
