<Project>
  <!-- Build output goes to the workspace's ignored target folder, never beside the sources. -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../../target/ace-mod</ArtifactsPath>
    <NuGetAudit>false</NuGetAudit>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
