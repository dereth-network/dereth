<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Dereth.Network</AssemblyName>
    <RootNamespace>Dereth.Network</RootNamespace>
    <Version>0.1.3</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <!-- AceDirectory as given, a relative one read from the folder the build was started in rather
       than from this file's (a property given with -p: cannot itself be changed here). -->
  <PropertyGroup>
    <AceFolder Condition="'$(AceDirectory)' != ''">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine('$(MSBuildStartupDirectory)', '$(AceDirectory)'))'))</AceFolder>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ACE.Server"><HintPath>$(AceFolder)/ACE.Server.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.Common"><HintPath>$(AceFolder)/ACE.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.Entity"><HintPath>$(AceFolder)/ACE.Entity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.Database"><HintPath>$(AceFolder)/ACE.Database.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(AceFolder)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="log4net"><HintPath>$(AceFolder)/log4net.dll</HintPath><Private>false</Private></Reference>
    <None Update="Meta.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Settings.json.example" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckAceDirectory" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AceFolder)/ACE.Server.dll')" Text="Set -p:AceDirectory to the folder that holds your server's ACE.Server.dll." />
  </Target>
</Project>
