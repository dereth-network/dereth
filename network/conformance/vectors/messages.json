      "expect": { "id": "r2", "from": "Ann@frost", "text": "evening all", "via": "discord" },
      "note": "a line its speaker's person said in Discord, which the hub asked the world to say" },
    { "type": "room.line", "frame": "{\"type\":\"room.line\",\"room\":\"roleplay\",\"from\":\"Ann@frost\",\"text\":\"evening all\",\"via\":\"discord\"}",
      "expect": { "room": "roleplay", "via": "discord" } },
    { "type": "room.result", "frame": "{\"type\":\"room.result\",\"id\":\"r1\",\"outcome\":\"rate_limited\"}" },
    { "type": "channel", "frame": "{\"type\":\"channel\",\"id\":\"c1\",\"op\":\"invite\",\"channel\":\"oldguard\",\"by\":\"Ann@frost\",\"who\":\"Bob@coldeve\"}" },
    { "type": "channel.result", "frame": "{\"type\":\"channel.result\",\"id\":\"c1\",\"outcome\":\"not_invited\",\"channel\":\"oldguard\"}" },
    { "type": "channel.result", "frame": "{\"type\":\"channel.result\",\"id\":\"c2\",\"outcome\":\"ok\",\"channel\":\"oldguard\",\"members\":[\"Ann@frost\",\"Bob@coldeve\"]}" },
    { "type": "channel.result", "frame": "{\"type\":\"channel.result\",\"id\":\"c3\",\"outcome\":\"ok\",\"channel\":\"list\",\"channels\":[\"oldguard\",\"new-guard\"]}" },
    { "type": "channel.invite", "frame": "{\"type\":\"channel.invite\",\"channel\":\"oldguard\",\"by\":\"Ann@frost\",\"to\":\"Bob@coldeve\"}" },
    { "type": "channel.line", "frame": "{\"type\":\"channel.line\",\"channel\":\"oldguard\",\"from\":\"Ann@frost\",\"to\":\"Bob@coldeve\",\"text\":\"tonight?\"}",
      "expect": { "channel": "oldguard", "from": "Ann@frost", "to": "Bob@coldeve", "text": "tonight?" } },
    { "type": "person", "frame": "{\"type\":\"person\",\"id\":\"p1\",\"op\":\"code\",\"who\":\"Ann@frost\"}", "expect": {"id": "p1", "op": "code", "who": "Ann@frost"} },
    { "type": "person", "frame": "{\"type\":\"person\",\"id\":\"p2\",\"op\":\"befriend\",\"who\":\"Ann@frost\",\"target\":\"Bob@coldeve\"}", "expect": {"id": "p2", "op": "befriend", "who": "Ann@frost", "target": "Bob@coldeve"} },
    { "type": "person", "frame": "{\"type\":\"person\",\"id\":\"p3\",\"op\":\"alts\",\"who\":\"Ann@frost\",\"shown\":false}", "expect": {"op": "alts", "shown": false},
      "note": "sent by worlds of the network's first version alone, which the hub answers" },
    { "type": "person", "frame": "{\"type\":\"person\",\"id\":\"p5\",\"op\":\"carry\",\"who\":\"Ann@frost\",\"targets\":[\"Bob@coldeve\",\"Cat@dreamweave\"]}", "expect": {"op": "carry", "who": "Ann@frost", "targets": ["Bob@coldeve", "Cat@dreamweave"]} },
    { "type": "person.result", "frame": "{\"type\":\"person.result\",\"id\":\"p1\",\"outcome\":\"ok\",\"code\":\"K7QD-2MXP\",\"expires_secs\":600,\"url\":\"https://dereth.network/link/#K7QD-2MXP\"}", "expect": {"id": "p1", "outcome": "ok", "code": "K7QD-2MXP", "expires_secs": 600, "url": "https://dereth.network/link/#K7QD-2MXP"} },
    { "type": "person.result", "frame": "{\"type\":\"person.result\",\"id\":\"p4\",\"outcome\":\"ok\",\"characters\":[\"Bob@coldeve\",\"Bob@dreamweave\"]}", "expect": {"outcome": "ok", "characters": ["Bob@coldeve", "Bob@dreamweave"]} },
    { "type": "person.result", "frame": "{\"type\":\"person.result\",\"id\":\"p2\",\"outcome\":\"not_linked\"}", "expect": {"outcome": "not_linked", "characters": []} },
    { "type": "person.watch", "frame": "{\"type\":\"person.watch\",\"who\":\"Ann@frost\",\"on\":true}", "expect": {"who": "Ann@frost", "on": true} },
    { "type": "person.friends", "frame": "{\"type\":\"person.friends\",\"to\":\"Ann@frost\",\"linked\":true,\"alts\":\"shown\",\"persons\":[{\"handle\":\"Bob@coldeve\",\"characters\":[\"Bob@coldeve\",\"Bob@dreamweave\"]}]}", "expect": {"to": "Ann@frost", "linked": true, "alts": "shown", "persons": [{"handle": "Bob@coldeve", "characters": ["Bob@coldeve", "Bob@dreamweave"]}]},
      "note": "`alts` is always `shown`, for worlds of the network's first version, which read it" },
    { "type": "person.friends", "frame": "{\"type\":\"person.friends\",\"to\":\"Ann@frost\",\"linked\":false,\"alts\":\"shown\",\"persons\":[]}", "expect": {"linked": false, "persons": []} },
    { "type": "person.friends", "frame": "{\"type\":\"person.friends\",\"to\":\"Ann@frost\",\"linked\":false,\"alts\":\"shown\",\"persons\":[{\"handle\":\"Bob@coldeve\",\"characters\":[\"Bob@coldeve\"]}]}", "expect": {"linked": false, "persons": [{"handle": "Bob@coldeve", "characters": ["Bob@coldeve"]}]} },
