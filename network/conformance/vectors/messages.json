{
  "about": "The link messages (docs/network/02-link-protocol.md). Every `ok` frame must parse as its type, and a write of what was read must hold every field of the frame with the same value (it may add fields with their defaults) and read back unchanged; where an `ok` case gives `expect`, the message read must have those field values, by the meaning of each field, not by the implementation writing it again. Every `unknown` frame is skipped; every `malformed` frame is refused. In a frame, `${c*N}` stands for the character c written N times.",
  "ok": [
    { "type": "hello", "frame": "{\"type\":\"hello\",\"proto\":1,\"software\":\"example 1.0\"}" },
    { "type": "welcome", "frame": "{\"type\":\"welcome\",\"proto\":1,\"world\":\"coldeve\",\"hub\":\"example hub 1.0\",\"worlds\":[{\"slug\":\"coldeve\",\"name\":\"Coldeve\",\"online\":true}],\"rooms\":[\"global\"],\"limits\":{\"tells_per_character\":{\"burst\":10.0,\"per_sec\":0.5},\"room_lines_per_character\":{\"burst\":3.0,\"per_sec\":0.2},\"messages_per_world\":{\"burst\":200.0,\"per_sec\":50.0},\"room_lines_per_world\":{\"burst\":10.0,\"per_sec\":1.0},\"tells_per_recipient\":{\"burst\":20.0,\"per_sec\":1.0},\"pair_burst\":20,\"pair_window_secs\":60.0,\"pair_block_secs\":300.0,\"hold_secs\":60.0,\"result_timeout_secs\":100.0}}",
      "expect": { "world": "coldeve", "worlds": 1, "hold_secs": 60.0, "result_timeout_secs": 100.0, "tells_per_character.burst": 10.0 } },
    { "type": "welcome", "frame": "{\"type\":\"welcome\",\"proto\":1,\"world\":\"coldeve\",\"hub\":\"an older hub\",\"worlds\":[],\"rooms\":[],\"limits\":{\"tells_per_character\":{\"burst\":10.0,\"per_sec\":0.5},\"room_lines_per_character\":{\"burst\":3.0,\"per_sec\":0.2},\"messages_per_world\":{\"burst\":200.0,\"per_sec\":50.0},\"pair_burst\":20,\"pair_window_secs\":60.0,\"pair_block_secs\":300.0,\"hold_secs\":60.0,\"result_timeout_secs\":100.0}}",
      "note": "a hub that leaves out the limits added later: they take their defaults" },
    { "type": "world", "frame": "{\"type\":\"world\",\"slug\":\"frost\",\"name\":\"Frost\",\"online\":false}" },
    { "type": "status", "frame": "{\"type\":\"status\",\"state\":\"online\",\"players_online\":12}" },
    { "type": "status", "frame": "{\"type\":\"status\",\"state\":\"maintenance\"}" },
    { "type": "watch", "frame": "{\"type\":\"watch\",\"owner\":\"Ann@frost\",\"target\":\"Bob@coldeve\",\"on\":true}",
      "expect": { "owner": "Ann@frost", "target": "Bob@coldeve", "on": true } },
    { "type": "presence", "frame": "{\"type\":\"presence\",\"to\":\"Ann@frost\",\"of\":\"Bob@coldeve\",\"online\":true}",
      "expect": { "to": "Ann@frost", "of": "Bob@coldeve", "online": true } },
    { "type": "tell", "frame": "{\"type\":\"tell\",\"id\":\"t1\",\"from\":\"Ann@frost\",\"to\":\"Bob@coldeve\",\"text\":\"still playing?\",\"friend\":true}",
      "expect": { "id": "t1", "from": "Ann@frost", "to": "Bob@coldeve", "text": "still playing?", "friend": true } },
    { "type": "tell", "frame": "{\"type\":\"tell\",\"id\":\"t2\",\"from\":\"Ann@frost\",\"to\":\"oldguard@channel\",\"text\":\"anyone?\"}",
      "expect": { "id": "t2", "from": "Ann@frost", "to": "oldguard@channel", "text": "anyone?", "friend": false } },
    { "type": "tell", "frame": "{\"type\":\"tell\",\"id\":\"t3\",\"from\":\"Ann@frost\",\"to\":\"Bob@coldeve\",\"text\":\"${x*1024}\"}",
      "note": "text of 1,024 characters, the most a link message carries" },
    { "type": "tell.result", "frame": "{\"type\":\"tell.result\",\"id\":\"t1\",\"outcome\":\"delivered\"}",
      "expect": { "id": "t1", "outcome": "delivered" } },
    { "type": "tell.result", "frame": "{\"type\":\"tell.result\",\"id\":\"t1\",\"outcome\":\"afk\",\"message\":\"brb\"}",
      "expect": { "id": "t1", "outcome": "afk", "message": "brb" } },
    { "type": "tell.result", "frame": "{\"type\":\"tell.result\",\"id\":\"t1\",\"outcome\":\"not_on_network\"}" },
    { "type": "tell.result", "frame": "{\"type\":\"tell.result\",\"id\":\"t4\",\"outcome\":\"afk\",\"message\":\"${y*1024}\"}",
      "note": "an away text of 1,024 characters, the most a link message carries" },
    { "type": "room.join", "frame": "{\"type\":\"room.join\",\"room\":\"global\",\"on\":true}" },
    { "type": "room.say", "frame": "{\"type\":\"room.say\",\"id\":\"r1\",\"room\":\"global\",\"from\":\"Ann@frost\",\"text\":\"dance at 8\"}" },
    { "type": "room.line", "frame": "{\"type\":\"room.line\",\"room\":\"global\",\"from\":\"Ann@frost\",\"text\":\"dance at 8\"}",
