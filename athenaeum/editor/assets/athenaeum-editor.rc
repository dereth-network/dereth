// The application icon and version information, for linking into the executable. Windows only: the
// resource compiler is given this directory as an include directory, so the icon is named as the
// sibling file it is.
//
// The ordinal is 1 because Explorer shows the lowest-numbered icon in the file as the
// executable's own, and the window and the task bar take the executable's icon.
1 ICON "athenaeum.ico"

// The version information: Explorer's file properties show it, and the task bar names the
// editor's buttons by its file description rather than by the file's name. build.rs defines
// VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH and VERSION_TEXT from the crate's version.
#define STRINGIZE_(x) #x
#define STRINGIZE(x) STRINGIZE_(x)

1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Dereth Network"
            VALUE "FileDescription", "Athenaeum"
            VALUE "FileVersion", STRINGIZE(VERSION_TEXT)
            VALUE "InternalName", "athenaeum-editor"
            VALUE "OriginalFilename", "athenaeum-editor.exe"
            VALUE "ProductName", "Athenaeum"
            VALUE "ProductVersion", STRINGIZE(VERSION_TEXT)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
